# ============================================================
# Periskope API Credentials
# https://console.periskope.app/settings/api
# ============================================================
PERISKOPE_API_KEY=your_periskope_api_key_here
PERISKOPE_ORG_PHONE=919876543210

# ============================================================
# Supabase
# https://supabase.com → your project → Settings → API
# ============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ============================================================
# App Settings
# ============================================================
API_ENV=production
API_PORT=8000
LOG_LEVEL=INFO
MAX_BATCH_SIZE=500
